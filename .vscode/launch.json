{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: CLI Process",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/cli.py", 
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "process", 
        "--from",
        "now-1y",
        "--to",
        "now",
        "--min-risk",
        "5",
        "--verbose"
      ],
      "justMyCode": true
    },
    {
        "name": "Python: Typer Schema Command",
        "type": "debugpy",
        "request": "launch",
        "program": "cli.py",
        "args": ["schema", "init", "--verbose"],
        "console": "integratedTerminal",
        "purpose": ["debug-in-terminal"],
        "justMyCode": true
    },
      {
      "name": "Train Model",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/graph-ml/HGTConv/main.py",
      "args": ["--mode", "train"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/graph-ml/HGTConv",
      "justMyCode": true
    },
    {
      "name": "Evaluate Model",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/graph-ml/HGTConv/main.py",
      "args": ["--mode", "eval"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/graph-ml/HGTConv",
      "justMyCode": true

    },
    {
      "name": "Inference",
      "type": "debugpy",
      "request": "launch",
      "program":  "${workspaceFolder}/graph-ml/HGTConv/main.py",
      "args": [
        "--mode",
        "infer",
        "--input_seq",
        "T1071.001,T1102,T1132.001"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/graph-ml/HGTConv",
      "justMyCode": true
    }
  ]
}

